# Copy these into Render -> Environment (never commit real values to GitHub)

# Chairman login (console username + password)
ADMIN_USER=alpha01
ADMIN_PASS=change-this-password

# Secret key for the invitee link:  /mic?key=...
MIC_KEY=change-this-mic-key

# Legacy listener key (optional, keep it set)
LISTEN_KEY=change-this-listen-key

# Storage directory — use /var/data/madasha when the persistent disk is attached
DATA_DIR=/var/data/madasha

# How many hours of recordings to keep before auto-cleanup
KEEP_HOURS=12
